{
  "manifest_version": 3,
  "name": "Whimsy Lab",
  "version": "0.1.0",
  "description": "A test bench for Whimsy Web's design prompts: try different system prompts on any page and compare the results.",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Open Whimsy Lab" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
