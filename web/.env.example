# Copy to .env.local and fill in. NEVER commit real values.

# Public origin of the site (used in links and for the extension's allowed-origin list).
SITE_URL=http://localhost:3000

# Auth.js: a long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google sign-in (optional). Create OAuth credentials in Google Cloud Console; redirect URI:
#   {SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email sign-in links. In development with SMTP_* unset, the sign-in link is printed to the server console
# and written to data/dev-mail/ (DEV ONLY; refused when NODE_ENV=production).
SMTP_URL=
EMAIL_FROM="WhimsyWeb <no-reply@example.com>"

# Where the database and uploaded images live (defaults to ./data).
DATA_DIR=./data

# Comma-separated emails that become moderators on first sign-in.
MODERATOR_EMAILS=

# Extension id(s) allowed to talk to this site (comma-separated). Needed for "Apply theme".
EXTENSION_IDS=
