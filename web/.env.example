# Copy to .env.local and fill in. NEVER commit real values.

# Public origin of the site (used in links and for the extension's allowed-origin list).
SITE_URL=http://localhost:3000

# Auth.js: a long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google sign-in (optional). Create OAuth credentials in Google Cloud Console; redirect URI:
#   {SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email sign-in links are sent through Resend (https://resend.com). Without RESEND_API_KEY, development prints the
# link to the server console and writes it to data/dev-mail/ (DEV ONLY; refused when NODE_ENV=production).
RESEND_API_KEY=
EMAIL_FROM="Whimsy Web <no-reply@example.com>"

# Production behind a trusted reverse proxy: set to true so Auth.js trusts the forwarded host.
AUTH_TRUST_HOST=

# Where the database and uploaded images live (defaults to ./data).
DATA_DIR=./data

# Comma-separated emails that become moderators on first sign-in.
MODERATOR_EMAILS=

# Extension id(s) allowed to talk to this site (comma-separated). Needed for "Apply theme".
EXTENSION_IDS=
